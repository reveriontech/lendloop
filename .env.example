# Clerk (https://dashboard.clerk.com → your app → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk JWT issuer for Convex auth (your Clerk Frontend API URL).
# Also set it on the Convex deployment: npx convex env set CLERK_JWT_ISSUER_DOMAIN <value>
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Convex. `npx convex dev` fills these in.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# n8n automation secrets. Next.js doesn't read these: set them on the Convex
# deployment (npx convex env set ...) and on the n8n server (see the README).
# Fill them in here only to run the bundled n8n with:
#   docker compose --env-file .env.local up -d
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=
# Optional email sender on a domain verified in Resend, e.g. notifications@yourdomain.com
# (quote it to add a name: "LendLoop <notifications@yourdomain.com>").
# Empty = LendLoop <onboarding@resend.dev>. The Resend API key goes in an n8n credential, not here.
LENDLOOP_EMAIL_FROM=
