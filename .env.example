# Clerk (https://dashboard.clerk.com → your app → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Convex (run `npx convex dev` to get your deployment URL)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# n8n Webhook URL (the URL of your n8n borrow-request-notification webhook)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-borrow-webhook

# Shared HMAC secret for signing/verifying webhooks between the app and n8n
# Generate with: openssl rand -hex 32
N8N_HMAC_SECRET=your-random-32-byte-hex-secret

# Clerk JWT issuer for Convex auth (your Clerk Frontend API URL)
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
